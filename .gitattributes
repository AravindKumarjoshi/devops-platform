# Normalize line endings to LF in the repository
* text=auto eol=lf

# Explicitly declare text files
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.hcl       text eol=lf
*.tf        text eol=lf
*.json      text eol=lf
*.txt       text eol=lf
*.ini       text eol=lf
*.service   text eol=lf
*.timer     text eol=lf

# Binary files — no line ending conversion
*.png       binary
*.jpg       binary
*.gif       binary
*.ico       binary
*.zip       binary
